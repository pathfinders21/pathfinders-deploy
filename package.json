{
  "name": "pathfinders",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PathFinders: Where Guidance Meets Your Next Beginning. Connect with high caliber mentors, discover clear career roadmaps, and turn personal ambitions into measurable progress.",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:build": "wrangler deploy --dry-run --outdir=deploy-out",
    "db:local:reset": "rm -rf .wrangler/state/v3/d1"
  },
  "dependencies": {
    "@freebuff/auth": "^0.1.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vly-ai/integrations": "^0.6.14",
    "convex": "^1.46.0",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  }
}
